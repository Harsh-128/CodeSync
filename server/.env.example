# Copy this file to .env and fill in the values before starting the server.
# NEVER commit .env to version control.

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/codesync

# JWT secret — use a long, random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Port the server listens on (PaaS platforms like Render set this automatically)
PORT=3000

# Frontend origin for CORS (no trailing slash)
CLIENT_URL=http://localhost:5173
